local UT = "unreal-tournament-announcer::"

export function GetMultiKillLabel(kills: number)
    if kills == 2 then return "DOUBLE KILL", UT .. "A_DoubleKill", 25 end
    if kills == 3 then return "TRIPLE KILL", UT .. "A_TripleKill", 50 end
    if kills == 4 then return "MULTI KILL", UT .. "A_MultiKill", 100 end
    if kills == 5 then return "MEGA KILL!", UT .. "A_MegaKill", 200 end
    if kills == 6 then return "ULTRA KILL!!", UT .. "A_UltraKill", 300 end
    return "MONSTER KILL!!!", UT .. "A_MonsterKill", 500
end

export function GetKillStreakLabel(kills: number)
    if kills == 5 then return "KILLING SPREE", UT .. "A_KillingSpree", 100 end
    if kills == 10 then return "RAMPAGE!", UT .. "A_Rampage", 200 end
    if kills == 15 then return "DOMINATING!!", UT .. "A_Dominating", 300 end
    if kills == 20 then return "UNSTOPPABLE!!!", UT .. "A_Unstoppable", 400 end
    if kills >= 25 then return "GODLIKE!!!!!", UT .. "A_Godlike", 500 end
    return nil, nil, nil
end

export function GetCountdownAnnouncer(remainingTime: number): string?
    if remainingTime == 300 then return UT .. "A_Countdown_05_Minutes" end
    if remainingTime == 180 then return UT .. "A_Countdown_03_Minutes" end
    if remainingTime == 60 then return UT .. "A_Countdown_01_Minute" end
    if remainingTime == 30 then return UT .. "A_Countdown_30_Seconds" end
    if remainingTime >= 1 and remainingTime <= 10 then
        local s = tostring(remainingTime)
        if #s == 1 then s = "0" .. s end
        return UT .. "A_Countdown_" .. s
    end
    return nil
end
